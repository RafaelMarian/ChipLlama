{
 "title": "ESP32-C3-DEVKITM: UART hello + uptime",
 "device": "ESP32-C3-DEVKITM",
 "circuit": "esp32_c3_devkitm_uart",
 "blocks": {
  "languageVersion": 0,
  "blocks": [
   {
    "type": "cl_on_start",
    "inputs": {
     "DO": {
      "block": {
       "type": "cl_uart_println",
       "fields": {
        "TEXT": "hello from ESP32-C3-DEVKITM"
       }
      }
     }
    },
    "x": 20,
    "y": 20
   },
   {
    "type": "cl_every",
    "fields": {
     "MS": 1000
    },
    "inputs": {
     "DO": {
      "block": {
       "type": "cl_uart_print",
       "fields": {
        "TEXT": "ms=",
        "NL": false
       },
       "next": {
        "block": {
         "type": "cl_uart_print_num",
         "fields": {
          "NL": true
         },
         "inputs": {
          "VALUE": {
           "block": {
            "type": "cl_millis"
           }
          }
         }
        }
       }
      }
     }
    },
    "x": 20,
    "y": 160
   }
  ]
 }
}