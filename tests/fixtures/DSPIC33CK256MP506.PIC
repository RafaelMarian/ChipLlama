        <edc:DCRDef edc:access="--------n-------n-n---nn" edc:cname="FICD" edc:desc="ICD Configuration" edc:factorydefault="0xffffdf" edc:impl="0x80a3" edc:name="FICD" edc:nzwidth="24" edc:unimplval="1" edc:unused="0x0" edc:useinchecksum="0xffffdf" edc:_modsrc="DOS-02949_WACG.DCRModule" edc:_refcount="1" edc:_begin="0x0" edc:_end="0x100" edc:default="0xffffdf" edc:_addr="0x2BF28">
