                <edc:DCRFieldSemantic edc:cname="PS32768" edc:desc="1:32768" edc:when="(field &amp; 0x1f) == 0xf" />
                <edc:DCRFieldSemantic edc:cname="PS65536" edc:desc="1:65536" edc:when="(field &amp; 0x1f) == 0x10" />
                <edc:DCRFieldSemantic edc:cname="PS131072" edc:desc="1:131072" edc:when="(field &amp; 0x1f) == 0x11" />
                <edc:DCRFieldSemantic edc:cname="PS262144" edc:desc="1:262144" edc:when="(field &amp; 0x1f) == 0x12" />
                <edc:DCRFieldSemantic edc:cname="PS524288" edc:desc="1:524288" edc:when="(field &amp; 0x1f) == 0x13" />
                <edc:DCRFieldSemantic edc:cname="PS1048576" edc:desc="1:1048576" edc:when="(field &amp; 0x1f) == 0x14" />
                <edc:DCRFieldSemantic edc:cname="PS2097152" edc:desc="1:2097152" edc:when="(field &amp; 0x1f) == 0x15" />
                <edc:DCRFieldSemantic edc:cname="PS4194304" edc:desc="1:4194304" edc:when="(field &amp; 0x1f) == 0x16" />
                <edc:DCRFieldSemantic edc:cname="PS8388608" edc:desc="1:8388608" edc:when="(field &amp; 0x1f) == 0x17" />
                <edc:DCRFieldSemantic edc:cname="PS16777216" edc:desc="1:16777216" edc:when="(field &amp; 0x1f) == 0x18" />
                <edc:DCRFieldSemantic edc:cname="PS33554432" edc:desc="1:33554432" edc:when="(field &amp; 0x1f) == 0x19" />
                <edc:DCRFieldSemantic edc:cname="PS67108864" edc:desc="1:67108864" edc:when="(field &amp; 0x1f) == 0x1A" />
                <edc:DCRFieldSemantic edc:cname="PS134217728" edc:desc="1:134217728" edc:when="(field &amp; 0x1f) == 0x1B" />
                <edc:DCRFieldSemantic edc:cname="PS268435456" edc:desc="1:268435456" edc:when="(field &amp; 0x1f) == 0x1C" />
                <edc:DCRFieldSemantic edc:cname="PS536870912" edc:desc="1:536870912" edc:when="(field &amp; 0x1f) == 0x1D" />
                <edc:DCRFieldSemantic edc:cname="PS1073741824" edc:desc="1:1073741824" edc:when="(field &amp; 0x1f) == 0x1E" />
                <edc:DCRFieldSemantic edc:cname="PS2147483648" edc:desc="1:2147483648" edc:when="(field &amp; 0x1f) == 0x1F" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="RCLKSEL" edc:desc="Watchdog Timer Clock Select bits" edc:mask="0x3" edc:name="RCLKSEL" edc:nzwidth="2">
                <edc:DCRFieldSemantic edc:cname="LPRC" edc:desc="Always use LPRC" edc:when="(field &amp; 0x3) == 0x3" />
                <edc:DCRFieldSemantic edc:cname="FRC" edc:desc="Use FRC when WINDIS = 0, system clock is not INTOSC/LPRC and device is not in Sleep;otherwise, use INTOSC/LPRC" edc:when="(field &amp; 0x3) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="FCY" edc:desc="Use peripheral clk when system clock is not INTOSC/LPRC and device is not in Sleep;otherwise, use INTOSC/LPRC" edc:when="(field &amp; 0x3) == 0x1" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="WINDIS" edc:desc="Watchdog Timer Window Enable bit" edc:mask="0x1" edc:name="WINDIS" edc:nzwidth="1">
                <edc:DCRFieldSemantic edc:cname="ON" edc:desc="Watchdog Timer operates in Non-Window mode" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="OFF" edc:desc="Watchdog Timer operates in Window mode" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="WDTWIN" edc:desc="Watchdog Timer Window Select bits" edc:mask="0x3" edc:name="WDTWIN" edc:nzwidth="2">
                <edc:DCRFieldSemantic edc:cname="WIN25" edc:desc="WDT Window is 25% of WDT period" edc:when="(field &amp; 0x3) == 0x3" />
                <edc:DCRFieldSemantic edc:cname="WIN37" edc:desc="WDT Window is 37.5% of WDT period" edc:when="(field &amp; 0x3) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="WIN50" edc:desc="WDT Window is 50% of WDT period" edc:when="(field &amp; 0x3) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="WIN75" edc:desc="WDT Windo is 75% of WDT period" edc:when="(field &amp; 0x3) == 0x0" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="SWDTPS" edc:desc="Sleep Mode Watchdog Timer Post Scaler select bits" edc:mask="0x1f" edc:name="SWDTPS" edc:nzwidth="0x5">
                <edc:DCRFieldSemantic edc:cname="PS1" edc:desc="1:1" edc:when="(field &amp; 0x1f) == 0x0" />
                <edc:DCRFieldSemantic edc:cname="PS2" edc:desc="1:2" edc:when="(field &amp; 0x1f) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="PS4" edc:desc="1:4" edc:when="(field &amp; 0x1f) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="PS8" edc:desc="1:8" edc:when="(field &amp; 0x1f) == 0x3" />
                <edc:DCRFieldSemantic edc:cname="PS16" edc:desc="1:16" edc:when="(field &amp; 0x1f) == 0x4" />
                <edc:DCRFieldSemantic edc:cname="PS32" edc:desc="1:32" edc:when="(field &amp; 0x1f) == 0x5" />
                <edc:DCRFieldSemantic edc:cname="PS64" edc:desc="1:64" edc:when="(field &amp; 0x1f) == 0x6" />
                <edc:DCRFieldSemantic edc:cname="PS128" edc:desc="1:128" edc:when="(field &amp; 0x1f) == 0x7" />
                <edc:DCRFieldSemantic edc:cname="PS256" edc:desc="1:256" edc:when="(field &amp; 0x1f) == 0x8" />
                <edc:DCRFieldSemantic edc:cname="PS512" edc:desc="1:512" edc:when="(field &amp; 0x1f) == 0x9" />
                <edc:DCRFieldSemantic edc:cname="PS1024" edc:desc="1:1024" edc:when="(field &amp; 0x1f) == 0xa" />
                <edc:DCRFieldSemantic edc:cname="PS2048" edc:desc="1:2048" edc:when="(field &amp; 0x1f) == 0xb" />
                <edc:DCRFieldSemantic edc:cname="PS4096" edc:desc="1:4096" edc:when="(field &amp; 0x1f) == 0xc" />
                <edc:DCRFieldSemantic edc:cname="PS8192" edc:desc="1:8192" edc:when="(field &amp; 0x1f) == 0xd" />
                <edc:DCRFieldSemantic edc:cname="PS16384" edc:desc="1:16384" edc:when="(field &amp; 0x1f) == 0xe" />
                <edc:DCRFieldSemantic edc:cname="PS32768" edc:desc="1:32768" edc:when="(field &amp; 0x1f) == 0xf" />
                <edc:DCRFieldSemantic edc:cname="PS65536" edc:desc="1:65536" edc:when="(field &amp; 0x1f) == 0x10" />
                <edc:DCRFieldSemantic edc:cname="PS131072" edc:desc="1:131072" edc:when="(field &amp; 0x1f) == 0x11" />
                <edc:DCRFieldSemantic edc:cname="PS262144" edc:desc="1:262144" edc:when="(field &amp; 0x1f) == 0x12" />
                <edc:DCRFieldSemantic edc:cname="PS524288" edc:desc="1:524288" edc:when="(field &amp; 0x1f) == 0x13" />
                <edc:DCRFieldSemantic edc:cname="PS1048576" edc:desc="1:1048576" edc:when="(field &amp; 0x1f) == 0x14" />
                <edc:DCRFieldSemantic edc:cname="PS2097152" edc:desc="1:2097152" edc:when="(field &amp; 0x1f) == 0x15" />
                <edc:DCRFieldSemantic edc:cname="PS4194304" edc:desc="1:4194304" edc:when="(field &amp; 0x1f) == 0x16" />
