                <edc:DCRFieldSemantic edc:cname="IPL4" edc:desc="Alternate Register set assigned to IPL level 4" edc:when="(field &amp; 0x7) == 0x3" />
                <edc:DCRFieldSemantic edc:cname="IPL3" edc:desc="Alternate Register set assigned to IPL level 3" edc:when="(field &amp; 0x7) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="IPL2" edc:desc="Alternate Register set assigned to IPL level 2" edc:when="(field &amp; 0x7) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="IPL1" edc:desc="Alternate Register set assigned to IPL level 1" edc:when="(field &amp; 0x7) == 0x0" />
              </edc:DCRFieldDef>
            </edc:DCRMode>
          </edc:DCRModeList>
