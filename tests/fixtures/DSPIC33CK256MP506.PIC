                <edc:DCRFieldSemantic edc:cname="LPRC" edc:desc="Always use LPRC" edc:when="(field &amp; 0x3) == 0x3" />
                <edc:DCRFieldSemantic edc:cname="FRC" edc:desc="Use FRC when WINDIS = 0, system clock is not INTOSC/LPRC and device is not in Sleep;otherwise, use INTOSC/LPRC" edc:when="(field &amp; 0x3) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="FCY" edc:desc="Use peripheral clk when system clock is not INTOSC/LPRC and device is not in Sleep;otherwise, use INTOSC/LPRC" edc:when="(field &amp; 0x3) == 0x1" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="WINDIS" edc:desc="Watchdog Timer Window Enable bit" edc:mask="0x1" edc:name="WINDIS" edc:nzwidth="1">
                <edc:DCRFieldSemantic edc:cname="ON" edc:desc="Watchdog Timer operates in Non-Window mode" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="OFF" edc:desc="Watchdog Timer operates in Window mode" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="WDTWIN" edc:desc="Watchdog Timer Window Select bits" edc:mask="0x3" edc:name="WDTWIN" edc:nzwidth="2">
                <edc:DCRFieldSemantic edc:cname="WIN25" edc:desc="WDT Window is 25% of WDT period" edc:when="(field &amp; 0x3) == 0x3" />
                <edc:DCRFieldSemantic edc:cname="WIN37" edc:desc="WDT Window is 37.5% of WDT period" edc:when="(field &amp; 0x3) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="WIN50" edc:desc="WDT Window is 50% of WDT period" edc:when="(field &amp; 0x3) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="WIN75" edc:desc="WDT Windo is 75% of WDT period" edc:when="(field &amp; 0x3) == 0x0" />
              </edc:DCRFieldDef>
