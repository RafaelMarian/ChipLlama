                <edc:DCRFieldSemantic edc:cname="PGD1" edc:desc="Communicate on PGC1 and PGD1" edc:when="(field &amp; 0x3) == 0x3" />
                <edc:DCRFieldSemantic edc:cname="PGD2" edc:desc="Communicate on PGC2 and PGD2" edc:when="(field &amp; 0x3) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="PGD3" edc:desc="Communicate on PGC3 and PGD3" edc:when="(field &amp; 0x3) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="NONE" edc:desc="Reserved, do not use" edc:when="(field &amp; 0x3) == 0x0" />
              </edc:DCRFieldDef>
              <edc:AdjustPoint edc:offset="1" />
              <edc:AdjustPoint edc:offset="1" />
              <edc:AdjustPoint edc:offset="1" />
              <edc:DCRFieldDef edc:cname="JTAGEN" edc:desc="JTAG Enable bit" edc:mask="0x1" edc:name="JTAGEN" edc:nzwidth="0x1">
                <edc:DCRFieldSemantic edc:cname="ON" edc:desc="JTAG is enabled" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="OFF" edc:desc="JTAG is disabled" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:AdjustPoint edc:offset="1" />
              <edc:DCRFieldDef edc:cname="DEBUG" edc:desc="Background Debug" edc:ishidden="true" edc:isidehidden="true" edc:islanghidden="true" edc:mask="0x1" edc:name="DEBUG" edc:nzwidth="0x1">
                <edc:DCRFieldSemantic edc:cname="OFF" edc:desc="Disabled" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="ON" edc:desc="Enabled" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:AdjustPoint edc:offset="7" />
              <edc:DCRFieldDef edc:cname="NOBTSWP" edc:desc="BOOTSWP instruction disable bit" edc:mask="0x1" edc:name="NOBTSWP" edc:nzwidth="0x1">
                <edc:DCRFieldSemantic edc:cname="DISABLED" edc:desc="BOOTSWP instruction is disabled" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="ENABLED" edc:desc="BOOTSWP instruction is enabled" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
            </edc:DCRMode>
          </edc:DCRModeList>
