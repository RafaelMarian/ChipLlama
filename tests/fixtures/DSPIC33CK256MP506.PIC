        <edc:AdjustPoint edc:offset="0xB4" edc:_modsrc="DOS-02949_WACG.DCRModule" edc:_refcount="2" edc:_begin="0x0" edc:_end="0x100" edc:_addr="0x15F48" />
        <edc:DCRDef edc:access="nnnnnnnnnnnnnnnnnnnnnnnn" edc:cname="FBTSEQ" edc:desc="Boot Sequence Configuration Register" edc:factorydefault="0xffffff" edc:impl="0xffffff" edc:ishidden="false" edc:name="FBTSEQ" edc:nzwidth="24" edc:unimplval="1" edc:unused="0x0" edc:useinchecksum="0x000000" edc:_modsrc="DOS-02949_WACG.DCRModule" edc:_refcount="2" edc:_begin="0x0" edc:_end="0x100" edc:default="0xffffff" edc:_addr="0x15FFC">
          <edc:AliasList />
          <edc:DCRModeList>
            <edc:DCRMode edc:id="DS.0">
              <edc:DCRFieldDef edc:cname="BSEQ" edc:desc="Relative value defining which partition will be active after device Reset; the partition containing a lower boot number will be active" edc:mask="0xfff" edc:name="BSEQ" edc:nzwidth="12">
                <edc:DCRFieldValueRange edc:cname="BSEQ" edc:desc="Boot Sequence Number bits" edc:max="0xfff" edc:min="0x0" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="IBSEQ" edc:desc="The one's complement of BSEQ; must be calculated by the user and written during device programming." edc:mask="0xfff" edc:name="IBSEQ" edc:nzwidth="12">
                <edc:DCRFieldValueRange edc:cname="IBSEQ" edc:desc="Inverse Boot Sequence Number bits" edc:max="0xfff" edc:min="0x0" />
              </edc:DCRFieldDef>
            </edc:DCRMode>
          </edc:DCRModeList>
        </edc:DCRDef>
