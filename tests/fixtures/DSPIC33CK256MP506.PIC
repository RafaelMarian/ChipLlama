      <edc:ResetSector edc:beginaddr="0x400000" edc:endaddr="0x400004" edc:regionid="reset" />
      <edc:VectorSector edc:beginaddr="0x400004" edc:endaddr="0x400200" edc:regionid="ivt" />
      <edc:CodeSector edc:beginaddr="0x400200" edc:endaddr="0x415F00" edc:regionid="program" />
      <edc:WORMHoleSector edc:beginaddr="0x415F00" edc:endaddr="0x416000" edc:regionid="cfgmem">
        <edc:DCRDef edc:access="--------n---nnnnnnn-nnnn" edc:cname="FSEC" edc:desc="Security Configuration Options" edc:factorydefault="0xffffff" edc:impl="0x008fef" edc:ishidden="false" edc:name="FSEC" edc:nzwidth="24" edc:unimplval="1" edc:unused="0x0" edc:useinchecksum="0xFFFFFF" edc:_modsrc="DOS-02949_WACG.DCRModule" edc:_refcount="3" edc:_begin="0x0" edc:_end="0x100" edc:default="0xffffff" edc:_addr="0x415F00">
          <edc:AliasList />
          <edc:DCRModeList>
            <edc:DCRMode edc:id="DS.0">
              <edc:DCRFieldDef edc:cname="BWRP" edc:desc="Boot Segment Write-Protect bit" edc:mask="0x1" edc:name="BWRP" edc:nzwidth="1">
                <edc:DCRFieldSemantic edc:cname="OFF" edc:codeguardidref="PgmBootWrtProtectOff" edc:desc="Boot Segment may be written" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="ON" edc:codeguardidref="PgmBootWrtProtectOn" edc:desc="Boot Segment is write protected" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="BSS" edc:desc="Boot Segment Code-Protect Level bits" edc:mask="0x3" edc:name="BSS" edc:nzwidth="2">
                <edc:DCRFieldSemantic edc:cname="DISABLED" edc:codeguardidref="PgmBootNone" edc:desc="No Protection (other than BWRP)" edc:when="(field &amp; 0x3) == 0x3">
                  <edc:Checksum edc:checksumalgo="0x00" />
                </edc:DCRFieldSemantic>
                <edc:DCRFieldSemantic edc:cname="STNDRD" edc:codeguardidref="PgmBootStandard" edc:desc="Standard Security" edc:when="(field &amp; 0x3) == 0x2">
                  <edc:Checksum edc:checksumalgo="0x80" />
                </edc:DCRFieldSemantic>
                <edc:DCRFieldSemantic edc:cname="HIGH" edc:codeguardidref="PgmBootHigh" edc:desc="High Security" edc:when="(field &amp; 0x2) == 0x0">
                  <edc:Checksum edc:checksumalgo="0x80" />
                </edc:DCRFieldSemantic>
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="BSEN" edc:desc="Boot Segment Control bit" edc:mask="0x1" edc:name="BSEN" edc:nzwidth="1">
                <edc:DCRFieldSemantic edc:cname="OFF" edc:desc="No Boot Segment" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="ON" edc:desc="Boot Segment size determined by FBSLIM" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:AdjustPoint edc:offset="1" />
              <edc:DCRFieldDef edc:cname="GWRP" edc:desc="General Segment Write-Protect bit" edc:mask="0x1" edc:name="GWRP" edc:nzwidth="1">
                <edc:DCRFieldSemantic edc:cname="OFF" edc:codeguardidref="PgmGenWrtProtectOff" edc:desc="General Segment may be written" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="ON" edc:codeguardidref="PgmGenWrtProtectOn" edc:desc="General Segment is write protected" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="GSS" edc:desc="General Segment Code-Protect Level bits" edc:mask="0x3" edc:name="GSS" edc:nzwidth="2">
                <edc:DCRFieldSemantic edc:cname="DISABLED" edc:codeguardidref="PgmGenNone" edc:desc="No Protection (other than GWRP)" edc:when="(field &amp; 0x3) == 0x3">
                  <edc:Checksum edc:checksumalgo="0x00" />
                </edc:DCRFieldSemantic>
                <edc:DCRFieldSemantic edc:cname="STNDRD" edc:codeguardidref="PgmGenStd" edc:desc="Standard Security" edc:when="(field &amp; 0x3) == 0x2">
                  <edc:Checksum edc:checksumalgo="0x80" />
                </edc:DCRFieldSemantic>
                <edc:DCRFieldSemantic edc:cname="HIGH" edc:codeguardidref="PgmGenHigh" edc:desc="High Security" edc:when="(field &amp; 0x2) == 0x0">
                  <edc:Checksum edc:checksumalgo="0x80" />
                </edc:DCRFieldSemantic>
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="CWRP" edc:desc="Configuration Segment Write-Protect bit" edc:mask="0x1" edc:name="CWRP" edc:nzwidth="1">
                <edc:DCRFieldSemantic edc:cname="OFF" edc:codeguardidref="PgmConfigWrtProtectOff" edc:desc="Configuration Segment may be written" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="ON" edc:codeguardidref="PgmConfigWrtProtectOn" edc:desc="Configuration Segment is write protected" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="CSS" edc:desc="Configuration Segment Code-Protect Level bits" edc:mask="0x7" edc:name="CSS" edc:nzwidth="3">
                <edc:DCRFieldSemantic edc:cname="DISABLED" edc:codeguardidref="PgmConfigNone" edc:desc="No Protection (other than CWRP)" edc:when="(field &amp; 0x7) == 0x7">
                  <edc:Checksum edc:checksumalgo="0x00" />
                </edc:DCRFieldSemantic>
                <edc:DCRFieldSemantic edc:cname="STNDRD" edc:codeguardidref="PgmConfigStd" edc:desc="Standard Security" edc:when="(field &amp; 0x7) == 0x6">
                  <edc:Checksum edc:checksumalgo="0x80" />
                </edc:DCRFieldSemantic>
                <edc:DCRFieldSemantic edc:cname="ENHNCD" edc:codeguardidref="PgmConfigEnh" edc:desc="Enhanced Security" edc:when="(field &amp; 0x7) == 0x4">
                  <edc:Checksum edc:checksumalgo="0x80" />
                </edc:DCRFieldSemantic>
                <edc:DCRFieldSemantic edc:cname="HIGH" edc:codeguardidref="PgmConfigHigh" edc:desc="High Security" edc:when="(field &amp; 0x4) == 0x0">
                  <edc:Checksum edc:checksumalgo="0x80" />
                </edc:DCRFieldSemantic>
              </edc:DCRFieldDef>
              <edc:AdjustPoint edc:offset="3" />
              <edc:DCRFieldDef edc:cname="AIVTDIS" edc:desc="Alternate Interrupt Vector Table bit" edc:mask="0x1" edc:name="AIVTDIS" edc:nzwidth="1">
                <edc:DCRFieldSemantic edc:cname="OFF" edc:desc="Disabled AIVT" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="ON" edc:desc="Enabled AIVT" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
            </edc:DCRMode>
          </edc:DCRModeList>
        </edc:DCRDef>
        <edc:AdjustPoint edc:offset="0xC" edc:_modsrc="DOS-02949_WACG.DCRModule" edc:_refcount="3" edc:_begin="0x0" edc:_end="0x100" edc:_addr="0x415F04" />
        <edc:DCRDef edc:access="-----------nnnnnnnnnnnnn" edc:cname="FBSLIM" edc:desc="Boot Segment Limit Configuration" edc:factorydefault="0xffffff" edc:impl="0x001fff" edc:ishidden="false" edc:name="FBSLIM" edc:nzwidth="24" edc:unimplval="1" edc:unused="0x0" edc:useinchecksum="0xffffff" edc:_modsrc="DOS-02949_WACG.DCRModule" edc:_refcount="3" edc:_begin="0x0" edc:_end="0x100" edc:default="0xffffff" edc:_addr="0x415F10">
          <edc:AliasList />
          <edc:DCRModeList>
            <edc:DCRMode edc:id="DS.0">
              <edc:DCRFieldDef edc:cname="BSLIM" edc:desc="Boot Segment Flash Page Address Limit bits" edc:mask="0x1fff" edc:name="BSLIM" edc:nzwidth="13">
                <edc:DCRFieldValueRange edc:cname="BSLIM" edc:desc="Boot Segment Flash page address  limit" edc:max="0x1fff" edc:min="0x0" />
              </edc:DCRFieldDef>
              <edc:AdjustPoint edc:offset="1" />
            </edc:DCRMode>
          </edc:DCRModeList>
        </edc:DCRDef>
        <edc:DCRDef edc:access="--------n---------------" edc:cname="FSIGN" edc:desc="Sign Bit Configuration" edc:factorydefault="0xff7fff" edc:impl="0x008000" edc:name="FSIGN" edc:nzwidth="24" edc:unimplval="1" edc:unused="0x0" edc:useinchecksum="0xFF7FFF" edc:_modsrc="DOS-02949_WACG.DCRModule" edc:_refcount="3" edc:_begin="0x0" edc:_end="0x100" edc:default="0xff7fff" edc:_addr="0x415F14">
          <edc:AliasList />
          <edc:DCRModeList>
            <edc:DCRMode edc:id="DS.0">
              <edc:AdjustPoint edc:offset="15" />
              <edc:DCRFieldDef edc:cname="SIGN" edc:desc="Sign Bit" edc:ishidden="true" edc:isidehidden="true" edc:islanghidden="true" edc:mask="0x1" edc:name="SIGN" edc:nzwidth="1">
                <edc:DCRFieldSemantic edc:cname="NONE" edc:desc="NONE" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
            </edc:DCRMode>
          </edc:DCRModeList>
        </edc:DCRDef>
        <edc:DCRDef edc:access="----------------n----nnn" edc:cname="FOSCSEL" edc:desc="Oscillator Configuration 1" edc:factorydefault="0xffffff" edc:impl="0x87" edc:name="FOSCSEL" edc:nzwidth="24" edc:unimplval="1" edc:unused="0x0" edc:useinchecksum="0xffffff" edc:_modsrc="DOS-02949_WACG.DCRModule" edc:_refcount="3" edc:_begin="0x0" edc:_end="0x100" edc:default="0xffffff" edc:_addr="0x415F18">
          <edc:AliasList />
          <edc:DCRModeList>
            <edc:DCRMode edc:id="DS.0">
              <edc:DCRFieldDef edc:cname="FNOSC" edc:desc="Oscillator Source Selection" edc:mask="0x7" edc:name="FNOSC" edc:nzwidth="0x3">
                <edc:DCRFieldSemantic edc:cname="FRCDIVN" edc:desc="Internal Fast RC (FRC) Oscillator with postscaler" edc:when="(field &amp; 0x7) == 0x7" />
                <edc:DCRFieldSemantic edc:cname="BFRC" edc:desc="Back up Fast RC (BFRC) Oscillator" edc:when="(field &amp; 0x7) == 0x6" />
                <edc:DCRFieldSemantic edc:cname="LPRC" edc:desc="Low-Power RC Oscillator (LPRC)" edc:when="(field &amp; 0x7) == 0x5" />
                <edc:DCRFieldSemantic edc:cname="PRIPLL" edc:desc="Primary Oscillator with PLL module (XT + PLL, HS + PLL, EC + PLL)" edc:when="(field &amp; 0x7) == 0x3" />
                <edc:DCRFieldSemantic edc:cname="PRI" edc:desc="Primary Oscillator (XT, HS, EC)" edc:when="(field &amp; 0x7) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="FRCPLL" edc:desc="Fast RC Oscillator with divide-by-N with PLL module (FRCPLL) " edc:when="(field &amp; 0x7) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="FRC" edc:desc="Internal Fast RC (FRC)" edc:when="(field &amp; 0x7) == 0x0" />
              </edc:DCRFieldDef>
              <edc:AdjustPoint edc:offset="3" />
              <edc:AdjustPoint edc:offset="1" />
              <edc:DCRFieldDef edc:cname="IESO" edc:desc="Two-speed Oscillator Start-up Enable bit" edc:mask="0x1" edc:name="IESO" edc:nzwidth="0x1">
                <edc:DCRFieldSemantic edc:cname="ON" edc:desc="Start up device with FRC, then switch to user-selected oscillator source" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="OFF" edc:desc="Start up with user-selected oscillator source" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:AdjustPoint edc:offset="0x2" />
            </edc:DCRMode>
          </edc:DCRModeList>
        </edc:DCRDef>
        <edc:DCRDef edc:access="-----------nnn-nnn---nnn" edc:cname="FOSC" edc:desc="Oscillator Configuration 2" edc:factorydefault="0xffffff" edc:impl="0x1dc7" edc:name="FOSC" edc:nzwidth="24" edc:unimplval="1" edc:unused="0x0" edc:useinchecksum="0xffffff" edc:_modsrc="DOS-02949_WACG.DCRModule" edc:_refcount="3" edc:_begin="0x0" edc:_end="0x100" edc:default="0xffffff" edc:_addr="0x415F1C">
          <edc:AliasList />
          <edc:DCRModeList>
            <edc:DCRMode edc:id="DS.0">
              <edc:DCRFieldDef edc:cname="POSCMD" edc:desc="Primary Oscillator Mode Select bits" edc:mask="0x3" edc:name="POSCMD" edc:nzwidth="0x2">
                <edc:DCRFieldSemantic edc:cname="NONE" edc:desc="Primary Oscillator disabled" edc:when="(field &amp; 0x3) == 0x3" />
                <edc:DCRFieldSemantic edc:cname="HS" edc:desc="HS Crystal Oscillator Mode" edc:when="(field &amp; 0x3) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="XT" edc:desc="XT Crystal Oscillator Mode" edc:when="(field &amp; 0x3) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="EC" edc:desc="EC (External Clock) Mode" edc:when="(field &amp; 0x3) == 0x0" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="OSCIOFNC" edc:desc="OSC2 Pin Function bit" edc:mask="0x1" edc:name="OSCIOFNC" edc:nzwidth="0x1">
                <edc:DCRFieldSemantic edc:cname="OFF" edc:desc="OSC2 is clock output" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="ON" edc:desc="OSC2 is general purpose digital I/O pin" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:AdjustPoint edc:offset="3" />
              <edc:DCRFieldDef edc:cname="FCKSM" edc:desc="Clock Switching Mode bits" edc:mask="0x3" edc:name="FCKSM" edc:nzwidth="0x2">
                <edc:DCRFieldSemantic edc:cname="CSDCMD" edc:desc="Both Clock switching and Fail-safe Clock Monitor are disabled" edc:when="(field &amp; 0x2) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="CSECMD" edc:desc="Clock switching is enabled,Fail-safe Clock Monitor is disabled" edc:when="(field &amp; 0x3) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="CSECME" edc:desc="Both Clock switching and Fail-safe Clock Monitor are enabled" edc:when="(field &amp; 0x3) == 0x0" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="PLLKEN" edc:desc="PLL Lock Status Control" edc:mask="0x1" edc:name="PLLKEN" edc:nzwidth="0x1">
                <edc:DCRFieldSemantic edc:cname="ON" edc:desc="PLL lock signal will be used to disable PLL clock output if lock is lost" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="OFF" edc:desc="PLL lock signal is not used; the PLL clock output will not be disabled if lock is lost" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
              <edc:AdjustPoint edc:offset="0x1" />
              <edc:DCRFieldDef edc:cname="XTCFG" edc:desc="XT Config" edc:mask="0x3" edc:name="XTCFG" edc:nzwidth="0x2">
                <edc:DCRFieldSemantic edc:cname="G0" edc:desc="4-8 MHz crystals" edc:when="(field &amp; 0x3) == 0x0" />
                <edc:DCRFieldSemantic edc:cname="G1" edc:desc="8-16 MHz crystals" edc:when="(field &amp; 0x3) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="G2" edc:desc="16-24 MHz crystals" edc:when="(field &amp; 0x3) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="G3" edc:desc="24-32 MHz crystals" edc:when="(field &amp; 0x3) == 0x3" />
              </edc:DCRFieldDef>
              <edc:DCRFieldDef edc:cname="XTBST" edc:desc="XT Boost" edc:mask="0x1" edc:name="XTBST" edc:nzwidth="0x1">
                <edc:DCRFieldSemantic edc:cname="ENABLE" edc:desc="Boost the kick-start" edc:when="(field &amp; 0x1) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="DISABLE" edc:desc="Default kick-start" edc:when="(field &amp; 0x1) == 0x0" />
              </edc:DCRFieldDef>
            </edc:DCRMode>
          </edc:DCRModeList>
        </edc:DCRDef>
        <edc:DCRDef edc:access="--------nnnnnnnnnnnnnnnn" edc:cname="FWDT" edc:desc="Watch Dog Configuration" edc:factorydefault="0xffffff" edc:impl="0x00ffff" edc:name="FWDT" edc:nzwidth="24" edc:unimplval="1" edc:unused="0x0" edc:useinchecksum="0xFFFFFF" edc:_modsrc="DOS-02949_WACG.DCRModule" edc:_refcount="3" edc:_begin="0x0" edc:_end="0x100" edc:default="0xffffff" edc:_addr="0x415F20">
          <edc:AliasList />
          <edc:DCRModeList>
            <edc:DCRMode edc:id="DS.0">
              <edc:DCRFieldDef edc:cname="RWDTPS" edc:desc="Run Mode Watchdog Timer Post Scaler select bits" edc:mask="0x1f" edc:name="RWDTPS" edc:nzwidth="5">
                <edc:DCRFieldSemantic edc:cname="PS1" edc:desc="1:1" edc:when="(field &amp; 0x1f) == 0x0" />
                <edc:DCRFieldSemantic edc:cname="PS2" edc:desc="1:2" edc:when="(field &amp; 0x1f) == 0x1" />
                <edc:DCRFieldSemantic edc:cname="PS4" edc:desc="1:4" edc:when="(field &amp; 0x1f) == 0x2" />
                <edc:DCRFieldSemantic edc:cname="PS8" edc:desc="1:8" edc:when="(field &amp; 0x1f) == 0x3" />
                <edc:DCRFieldSemantic edc:cname="PS16" edc:desc="1:16" edc:when="(field &amp; 0x1f) == 0x4" />
                <edc:DCRFieldSemantic edc:cname="PS32" edc:desc="1:32" edc:when="(field &amp; 0x1f) == 0x5" />
                <edc:DCRFieldSemantic edc:cname="PS64" edc:desc="1:64" edc:when="(field &amp; 0x1f) == 0x6" />
                <edc:DCRFieldSemantic edc:cname="PS128" edc:desc="1:128" edc:when="(field &amp; 0x1f) == 0x7" />
                <edc:DCRFieldSemantic edc:cname="PS256" edc:desc="1:256" edc:when="(field &amp; 0x1f) == 0x8" />
                <edc:DCRFieldSemantic edc:cname="PS512" edc:desc="1:512" edc:when="(field &amp; 0x1f) == 0x9" />
