# Copy to .env and fill in. NEVER commit .env. No real keys live in this repo.

# --- Model backend: "meta" (Meta Model API, default) or "baseten" (Muse Spark Open) ---
CHIPLLAMA_BACKEND=meta

# Meta Model API (https://dev.meta.ai/docs) - OpenAI-compatible, Bearer auth
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# minimal | low | medium | high | xhigh | max  ("none" is rejected with HTTP 400)
META_REASONING_EFFORT=high

# Baseten-hosted Muse Spark Open (OpenAI-compatible chat completions)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Slug documented by Meta + Baseten. If your hackathon guide gives a different id
# (e.g. meta-models/muse-spark-open-1026) put it here.
BASETEN_MODEL=meta-models/muse-spark-open
BASETEN_REASONING_EFFORT=

# Max tokens per model call (reasoning tokens count toward this on Muse Spark)
CHIPLLAMA_MAX_TOKENS=16000

# --- Target + toolchain ---
CHIPLLAMA_DEVICE=PIC24FJ256GB110
# Leave empty to auto-detect xc16-gcc on PATH / in the Microchip install folders.
# Windows example: C:\Program Files\Microchip\xc16\v2.10\bin\xc16-gcc.exe
XC16_GCC=
XC16_BIN2HEX=

# Datasheet (DS39897C). Not bundled (copyright). Put your copy here to enable page images.
DATASHEET_PDF=datasheets/DS39897C.pdf

# --- OPTIONAL flash step (OFF by default) using MPLAB IPE's ipecmd.exe ---
CHIPLLAMA_ENABLE_FLASH=0
# Windows example: C:\Program Files\Microchip\MPLABX\v6.20\mplab_platform\mplab_ipe\ipecmd.exe
IPECMD_PATH=
# PICkit 5 short name is PK5 -> -TPPK5. Others: PK4, PK3, ICD4, ICD5, SNAP, PKOB4 ...
IPECMD_TOOL=PK5
# Leave empty for the first/only connected tool, or set a serial number (-TS<serial>)
IPECMD_SERIAL=
# 1 = PICkit powers the target (-W). Leave 0 if the board has its own supply.
IPECMD_POWER_TARGET=0
